VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: exact redirect URL allowed in Supabase Auth settings
# VITE_AUTH_SITE_URL=http://localhost:5173

# Edge Function name for admin "Register Clinician" modal (must match deployed function)
VITE_CLINICIAN_INVITE_FUNCTION=invite-clinician
#
# Deploy once from repo root (Supabase CLI: https://supabase.com/docs/guides/cli):
#   supabase login
#   supabase link --project-ref YOUR_PROJECT_REF
#   supabase functions deploy invite-clinician

# Edge Function for login activity (recommended: captures IP from request headers)
# Falls back to supabase.rpc("log_login_activity", ...) when unset or on failure
# VITE_LOGIN_ACTIVITY_FUNCTION=log-login-activity
